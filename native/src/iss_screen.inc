  auto snapshot=[this](const std::string& name){for(const auto& h:popupHits)if(h.r.x<0||h.r.y<0||h.r.x+h.r.w>W||h.r.y+h.r.h>H)throw std::runtime_error("ISS popup control outside window");int w,h;SDL_GetRendererOutputSize(spaceRenderer,&w,&h);SDL_Surface* shot=SDL_CreateRGBSurfaceWithFormat(0,w,h,32,SDL_PIXELFORMAT_ARGB8888);SDL_RenderReadPixels(spaceRenderer,nullptr,shot->format->format,shot->pixels,shot->pitch);SDL_SaveBMP(shot,(game.userDir/(name+".bmp")).string().c_str());SDL_FreeSurface(shot);};
  clickPopup("iss-operations-tab");if(!popupISSOperations)throw std::runtime_error("ISS operations tab did not open");snapshot("iss-operations-normal");game.damageISS("lifeSupport",70,"DEBRIS");renderSpaceWindow();snapshot("iss-operations-emergency");clickPopup("iss-repair:lifeSupport");if(game.state["iss"]["repair"].is_null())throw std::runtime_error("ISS repair button failed");double science=game.state["iss"]["scienceHours"];game.advance(12);renderSpaceWindow();snapshot("iss-repair-half");if(game.state["iss"]["scienceHours"]!=science||std::abs(game.issStatus()["repairHoursLeft"].get<double>()-12)>1e-8)throw std::runtime_error("ISS repair ETA or separated scientist work failed");game.advance(12);renderSpaceWindow();snapshot("iss-repair-done");if(game.issStatus()["emergency"].get<bool>())throw std::runtime_error("ISS did not leave emergency after repair");
  game.state["weatherOverrides"]={{"florida",{{"risk",95},{"until",100000.}}}};game.state["iss"]["supplyPlan"]["enabled"]=false;clickPopup("iss-send:florida");game.advance(1);renderSpaceWindow();snapshot("iss-weather-delay");if(game.state["iss"]["shipments"][0]["status"]!="weatherDelay")throw std::runtime_error("ISS supply button did not respect weather");for(const auto& key:{"oxygen","water","food"})game.state["iss"]["stocks"][key]=10.;game.advance(1);renderSpaceWindow();snapshot("iss-critical-launch");if(!game.state["iss"]["shipments"][0]["forced"].get<bool>())throw std::runtime_error("Critical supply launch not visible");closeSpaceModel();game.state=original;spaceFeedback=feedback;std::cout<<"ISS operations UI: separate teams, emergency, repair clicks/ETA, weather delay and critical supply launch passed\n";
