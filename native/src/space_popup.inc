 bool spaceWindowEvent(const SDL_Event& event){
  if(!spaceWindow)return false;Uint32 id=0;switch(event.type){case SDL_WINDOWEVENT:id=event.window.windowID;break;case SDL_MOUSEMOTION:id=event.motion.windowID;break;case SDL_MOUSEBUTTONDOWN:case SDL_MOUSEBUTTONUP:id=event.button.windowID;break;case SDL_MOUSEWHEEL:id=event.wheel.windowID;break;case SDL_KEYDOWN:case SDL_KEYUP:id=event.key.windowID;break;case SDL_FINGERDOWN:case SDL_FINGERUP:case SDL_FINGERMOTION:id=event.tfinger.windowID;break;default:return false;}if(id!=SDL_GetWindowID(spaceWindow))return false;
  if((event.type==SDL_WINDOWEVENT&&event.window.event==SDL_WINDOWEVENT_CLOSE)||(event.type==SDL_KEYDOWN&&event.key.keysym.sym==SDLK_ESCAPE)){closeSpaceModel();return true;}
  swapSpaceWindowContext();try{if(event.type==SDL_MOUSEMOTION){mx=event.motion.x;my=event.motion.y;}if(!spaceModelPointer(event)&&event.type==SDL_MOUSEBUTTONDOWN&&event.button.button==SDL_BUTTON_LEFT){mx=event.button.x;my=event.button.y;auto targets=hits;for(auto it=targets.rbegin();it!=targets.rend();++it)if(mx>=it->r.x&&my>=it->r.y&&mx<it->r.x+it->r.w&&my<it->r.y+it->r.h){it->action();break;}}}catch(...){swapSpaceWindowContext();throw;}swapSpaceWindowContext();if(popupCloseRequested)closeSpaceModel();return true;
 }
