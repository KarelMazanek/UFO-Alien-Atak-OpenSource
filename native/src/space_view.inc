 // Camera constants and gestures are copied from iss3dScene/kourouModelCanvas in the reference HTML.
 SpaceCamera& spaceCamera(const std::string& type){return type=="iss"?issCamera:rocketCamera;}
 void resetSpaceCamera(const std::string& type){spaceCamera(type)=type=="iss"?SpaceCamera{.68,.34,1,27}:SpaceCamera{.34,.36,1.5,27};}
 void zoomSpaceCamera(const std::string& type,int direction,bool wheel){auto& c=spaceCamera(type);if(type=="iss")c.distance=std::clamp(c.distance-direction*(wheel?1.2:2.),16.,48.);else c.zoom=std::clamp(c.zoom*(wheel?(direction>0?1.08:.92):(direction>0?1.12:1/1.12)),.6,1.7);}
 std::array<double,3> projectSpacePoint(const std::string& type,double a,double b,double c,const SDL_Rect& area){
  const auto& camera=spaceCamera(type);double cy=cos(camera.yaw),sy=sin(camera.yaw),cp=cos(camera.pitch),sp=sin(camera.pitch);
  if(type=="iss"){double xx=cy*a-sy*b,q=sy*a+cy*b,yy=cp*q-sp*c,zz=sp*q+cp*c,scale=std::min(area.w,area.h)*1.32/(camera.distance-zz);return {area.x+area.w*.5+xx*scale,area.y+area.h*.51-yy*scale,zz};}
  double xx=a*cy-c*sy,z=a*sy+c*cy,yy=b*cp-z*sp,depth=b*sp+z*cp,k=100/(100+depth*.18),scale=std::min(area.w/106.,area.h/96.)*camera.zoom;
  return {area.x+area.w*.5+xx*scale*k,area.y+area.h*.89-yy*scale-40*k,depth};
 }
 bool spaceModelPointer(const SDL_Event& event){
  if((event.type==SDL_MOUSEBUTTONDOWN||event.type==SDL_MOUSEBUTTONUP)&&event.button.which==SDL_TOUCH_MOUSEID)return !modelTouches.empty();
  if(event.type==SDL_MOUSEMOTION&&event.motion.which==SDL_TOUCH_MOUSEID)return !modelTouches.empty();
  if(event.type==SDL_WINDOWEVENT&&event.window.event==SDL_WINDOWEVENT_FOCUS_LOST){modelDragging=false;modelTouches.clear();draggedModel.clear();SDL_CaptureMouse(SDL_FALSE);return false;}
  if(event.type==SDL_FINGERDOWN||event.type==SDL_FINGERMOTION||event.type==SDL_FINGERUP){
   int ww,wh;SDL_GetWindowSize(window,&ww,&wh);SDL_FPoint p;SDL_RenderWindowToLogical(renderer,int(event.tfinger.x*ww),int(event.tfinger.y*wh),&p.x,&p.y);
   auto existing=modelTouches.find(event.tfinger.fingerId);
   if(event.type==SDL_FINGERUP){if(existing==modelTouches.end())return false;modelTouches.erase(existing);modelPinchStart=0;if(modelTouches.empty()){modelDragging=false;draggedModel.clear();}else{modelLastX=modelTouches.begin()->second.x;modelLastY=modelTouches.begin()->second.y;}return true;}
   if(event.type==SDL_FINGERDOWN){if(modelTouches.empty()){for(const auto& view:modelViewports)if(p.x>=view.rect.x&&p.y>=view.rect.y&&p.x<view.rect.x+view.rect.w&&p.y<view.rect.y+view.rect.h){draggedModel=view.type;break;}if(draggedModel.empty())return false;modelDragging=true;modelLastX=modelStartX=p.x;modelLastY=modelStartY=p.y;modelStartYaw=spaceCamera(draggedModel).yaw;modelStartPitch=spaceCamera(draggedModel).pitch;}modelTouches[event.tfinger.fingerId]=p;if(modelTouches.size()==2&&draggedModel=="iss"){auto first=modelTouches.begin(),second=std::next(first);modelPinchStart=std::hypot(first->second.x-second->second.x,first->second.y-second->second.y);modelPinchDistance=issCamera.distance;}return true;}
   if(existing==modelTouches.end())return false;existing->second=p;if(modelTouches.size()>=2&&draggedModel=="iss"){auto first=modelTouches.begin(),second=std::next(first);double gap=std::hypot(first->second.x-second->second.x,first->second.y-second->second.y);if(modelPinchStart>0)issCamera.distance=std::clamp(modelPinchDistance*modelPinchStart/std::max(1.,gap),16.,48.);return true;}
   auto& c=spaceCamera(draggedModel);double dx=p.x-modelLastX,dy=p.y-modelLastY;if(draggedModel=="iss"){c.yaw+=dx*.009;c.pitch=std::clamp(c.pitch-dy*.008,-1.25,1.25);}else{c.yaw=modelStartYaw+(p.x-modelStartX)*.008;c.pitch=std::clamp(modelStartPitch+(p.y-modelStartY)*.006,-.2,1.05);}modelLastX=p.x;modelLastY=p.y;return true;
  }
  if(modelDragging){
   if(event.type==SDL_MOUSEMOTION){auto& c=spaceCamera(draggedModel);double dx=event.motion.x-modelLastX,dy=event.motion.y-modelLastY;if(draggedModel=="iss"){c.yaw+=dx*.009;c.pitch=std::clamp(c.pitch-dy*.008,-1.25,1.25);}else{c.yaw=modelStartYaw+(event.motion.x-modelStartX)*.008;c.pitch=std::clamp(modelStartPitch+(event.motion.y-modelStartY)*.006,-.2,1.05);}modelLastX=event.motion.x;modelLastY=event.motion.y;return true;}
   if(event.type==SDL_MOUSEBUTTONUP&&event.button.button==SDL_BUTTON_LEFT){modelDragging=false;draggedModel.clear();SDL_CaptureMouse(SDL_FALSE);return true;}
  }
  float px=mx,py=my;if(event.type==SDL_MOUSEBUTTONDOWN){px=event.button.x;py=event.button.y;}
  const ModelViewport* target=nullptr;for(auto it=modelViewports.rbegin();it!=modelViewports.rend();++it)if(px>=it->rect.x&&py>=it->rect.y&&px<it->rect.x+it->rect.w&&py<it->rect.y+it->rect.h){target=&*it;break;}if(!target)return false;
  if(event.type==SDL_MOUSEWHEEL){if(event.wheel.y)zoomSpaceCamera(target->type,event.wheel.y>0?1:-1,true);return true;}
  if(event.type==SDL_MOUSEBUTTONDOWN&&event.button.button==SDL_BUTTON_LEFT){if(event.button.clicks>=2){resetSpaceCamera(target->type);return true;}modelDragging=true;draggedModel=target->type;modelLastX=modelStartX=px;modelLastY=modelStartY=py;modelStartYaw=spaceCamera(draggedModel).yaw;modelStartPitch=spaceCamera(draggedModel).pitch;SDL_CaptureMouse(SDL_TRUE);return true;}return false;
 }
 void spaceModelControls(const std::string& type,int x,int y,int width){
  int part=(width-16)/3;control("−",x,y,part,28,[this,type]{zoomSpaceCamera(type,-1,false);});hits.back().name="space-zoom-out:"+type;
  control("RESET",x+part+8,y,part,28,[this,type]{resetSpaceCamera(type);});hits.back().name="space-reset:"+type;
  control("+",x+2*(part+8),y,part,28,[this,type]{zoomSpaceCamera(type,1,false);});hits.back().name="space-zoom-in:"+type;
 }
 void verifySpaceGestures(){
  auto oldPage=page,oldLocation=location,oldVisual=spaceVisual;auto oldISS=issCamera,oldRocket=rocketCamera;
  auto renderModel=[this]{hits.clear();modelViewports.clear();listScrollRegions.clear();layoutFrames.clear();rect(0,0,W,H,bg);renderScreen();};
  auto clickModel=[this](const std::string& name){auto found=std::find_if(hits.begin(),hits.end(),[&](const Hit& h){return h.name==name;});if(found==hits.end())throw std::runtime_error("Missing model control: "+name);found->action();};
  auto pixels=[this](SDL_Rect area){std::vector<Uint32> out(area.w*area.h);if(SDL_RenderReadPixels(renderer,&area,SDL_PIXELFORMAT_ARGB8888,out.data(),area.w*4))throw std::runtime_error(SDL_GetError());return out;};
  for(const auto& type:{std::string("iss"),std::string("kourou")}){
   resetSpaceCamera(type);SDL_Rect reference{0,0,772,470};auto p=projectSpacePoint(type,3,5,7,reference);auto expected=type=="iss"?std::array<double,3>{358.75803063529446,135.28908849479333,8.52491805463484}:std::array<double,3>{389.56972332802985,364.22456076648734,8.873947376020718};for(int i=0;i<3;++i)if(std::abs(p[i]-expected[i])>1e-9)throw std::runtime_error("Camera differs from original HTML projection");
   for(bool expanded:{true}){
    page=expanded?"space-visual":type=="iss"?"space-location":"launch-ramp";location=type=="iss"?"nasa":"esa";spaceVisual=type=="iss"?"iss":"ramp";resetSpaceCamera(type);renderModel();
    auto viewport=std::find_if(modelViewports.begin(),modelViewports.end(),[&](const ModelViewport& v){return v.type==type;});if(viewport==modelViewports.end())throw std::runtime_error("Interactive model viewport is missing");auto area=viewport->rect;auto baseline=pixels(area);auto original=spaceCamera(type);
    SDL_Event ev{};ev.type=SDL_MOUSEBUTTONDOWN;ev.button.button=SDL_BUTTON_LEFT;ev.button.clicks=1;ev.button.x=area.x+area.w/2;ev.button.y=area.y+area.h/2;if(!spaceModelPointer(ev)||!modelDragging)throw std::runtime_error("Model drag failed to start");ev.type=SDL_MOUSEMOTION;ev.motion.x=area.x+area.w/2+40;ev.motion.y=area.y+area.h/2+20;spaceModelPointer(ev);auto& c=spaceCamera(type);double expectedYaw=original.yaw+40*(type=="iss"?.009:.008),expectedPitch=original.pitch+20*(type=="iss"?-.008:.006);if(std::abs(c.yaw-expectedYaw)>1e-9||std::abs(c.pitch-expectedPitch)>1e-9)throw std::runtime_error("Drag sensitivity differs from HTML");if(type=="kourou"){ev.motion.y=area.y+area.h/2+1000;spaceModelPointer(ev);if(c.pitch!=1.05)throw std::runtime_error("Kourou pitch clamp differs from HTML");ev.motion.y=area.y+area.h/2+20;spaceModelPointer(ev);if(std::abs(c.pitch-expectedPitch)>1e-9)throw std::runtime_error("Kourou drag must remain relative to pointer-down position");}ev.type=SDL_MOUSEBUTTONUP;ev.button.button=SDL_BUTTON_LEFT;spaceModelPointer(ev);if(modelDragging)throw std::runtime_error("Model capture not released");renderModel();if(pixels(area)==baseline)throw std::runtime_error("Rotation did not change visible model pixels");
    clickModel("space-reset:"+type);renderModel();if(pixels(area)!=baseline)throw std::runtime_error("Reset did not restore original model image");mx=area.x+area.w/2;my=area.y+area.h/2;ev={};ev.type=SDL_MOUSEWHEEL;ev.wheel.y=1;if(!spaceModelPointer(ev))throw std::runtime_error("Wheel over model was not consumed");if(type=="iss"?std::abs(c.distance-25.8)>1e-9:std::abs(c.zoom-1.62)>1e-9)throw std::runtime_error("Wheel zoom differs from HTML");renderModel();if(pixels(area)==baseline)throw std::runtime_error("Zoom did not change visible model pixels");
    clickModel("space-reset:"+type);clickModel("space-zoom-in:"+type);if(type=="iss"?std::abs(c.distance-25)>1e-9:std::abs(c.zoom-1.68)>1e-9)throw std::runtime_error("Zoom button differs from HTML");clickModel("space-zoom-out:"+type);if(type=="iss"?c.distance!=27:std::abs(c.zoom-1.5)>1e-9)throw std::runtime_error("Zoom out button failed");
    for(int i=0;i<100;++i)zoomSpaceCamera(type,1,true);if(type=="iss"?c.distance!=16:c.zoom!=1.7)throw std::runtime_error("Zoom lower limit differs from HTML");for(int i=0;i<100;++i)zoomSpaceCamera(type,-1,true);if(type=="iss"?c.distance!=48:c.zoom!=.6)throw std::runtime_error("Zoom upper limit differs from HTML");
    ev={};ev.type=SDL_MOUSEBUTTONDOWN;ev.button.button=SDL_BUTTON_LEFT;ev.button.clicks=2;ev.button.x=area.x+area.w/2;ev.button.y=area.y+area.h/2;spaceModelPointer(ev);if(c.yaw!=original.yaw||c.pitch!=original.pitch||c.distance!=original.distance||c.zoom!=original.zoom)throw std::runtime_error("Double-click reset differs from HTML");
    if(type=="iss"&&expanded){auto touch=[&](Uint32 kind,SDL_FingerID finger,int x,int y){int wx,wy,ww,wh;SDL_RenderLogicalToWindow(renderer,float(x),float(y),&wx,&wy);SDL_GetWindowSize(window,&ww,&wh);SDL_Event fingerEvent{};fingerEvent.type=kind;fingerEvent.tfinger.fingerId=finger;fingerEvent.tfinger.x=float(wx)/ww;fingerEvent.tfinger.y=float(wy)/wh;if(!spaceModelPointer(fingerEvent))throw std::runtime_error("ISS touch gesture not consumed");};int cx=area.x+area.w/2,cy=area.y+area.h/2;touch(SDL_FINGERDOWN,1,cx-20,cy);touch(SDL_FINGERDOWN,2,cx+20,cy);touch(SDL_FINGERMOTION,2,cx+60,cy);if(std::abs(issCamera.distance-16)>1e-9)throw std::runtime_error("ISS two-finger pinch failed");touch(SDL_FINGERUP,2,cx+60,cy);touch(SDL_FINGERUP,1,cx-20,cy);if(modelDragging||!modelTouches.empty())throw std::runtime_error("ISS touch capture not released");resetSpaceCamera(type);}
    ev.button.clicks=1;spaceModelPointer(ev);ev.type=SDL_WINDOWEVENT;ev.window.event=SDL_WINDOWEVENT_FOCUS_LOST;spaceModelPointer(ev);if(modelDragging)throw std::runtime_error("Lost focus must cancel model dragging");mx=10;my=10;ev.type=SDL_MOUSEWHEEL;ev.wheel.y=1;if(spaceModelPointer(ev))throw std::runtime_error("Model stole wheel outside its viewport");
    renderModel();SDL_Surface* shot=SDL_CreateRGBSurfaceWithFormat(0,W,H,32,SDL_PIXELFORMAT_ARGB8888);SDL_RenderReadPixels(renderer,nullptr,shot->format->format,shot->pixels,shot->pitch);SDL_SaveBMP(shot,(game.userDir/("gesture-"+type+(expanded?"-expanded.bmp":"-inline.bmp"))).string().c_str());SDL_FreeSurface(shot);
   }
  }
  page=oldPage;location=oldLocation;spaceVisual=oldVisual;issCamera=oldISS;rocketCamera=oldRocket;modelDragging=false;draggedModel.clear();renderModel();std::cout<<"ISS/Ariane: HTML projection, mouse orbit, visible zoom, +/- buttons, limits, double-click reset, focus loss and viewport isolation passed in reference model viewport\n";
 }
